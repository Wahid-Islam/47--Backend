# Copy to .env.development.local, or run: vercel env pull .env.development.local
#
# NEVER commit a file containing real values. .gitignore covers .env*.

# Neon connection string. Use the pooled URL for serverless functions --
# each invocation opens its own connection, and the unpooled URL will
# exhaust Neon's connection limit under load.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Only needed for migrations, which run DDL in a single session.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign session JWTs. Generate a fresh one, never reuse an
# example, and treat it like a password:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

# How long an access token stays valid.
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
# The Flutter dev server port changes per run, so add whatever
# `flutter run -d chrome` prints. Do not use "*" -- the API sends
# credentials-bearing responses.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8081
