# Neon Postgres (pooled URL for the API; optional unpooled for migrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Session tokens — use a long random string (≥ 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Optional comma-separated extra CORS origins (prod Flutter hosts are allowed by default)
CORS_ALLOWED_ORIGINS=http://localhost:3000
