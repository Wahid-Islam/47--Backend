{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index?path=health" },
    { "source": "/api", "destination": "/api/index?path=health" },
    { "source": "/api/index", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index?path=$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
